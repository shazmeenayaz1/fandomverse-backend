{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "node_modules/sql.js/dist/**"
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/api",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
